# Copie para .env e ajuste. Tudo aqui é opcional.

# Porta em que o sistema abre nesta máquina.
OLHODIGITAL_PORTA=8080

# 127.0.0.1 só aceita acesso desta máquina. Para usar pelo celular na mesma rede,
# troque por 0.0.0.0. O acesso passa pelo login, mas sem HTTPS a senha viaja aberta:
# faça isso só em rede de confiança.
OLHODIGITAL_ENDERECO=127.0.0.1

OLHODIGITAL_SENHA_BANCO=olhodigital

# Vazio lê as letras com a CNN base. O modelo afinado só deve ser ligado para ler
# folhas novas da coleta, porque ele foi treinado nas folhas de desenvolvimento e
# medir nelas seria medir no treino. Na coleta, use:
# OLHODIGITAL_MODELO_LETRAS=/modelos/cnn_nome_afinada_inteira.keras
OLHODIGITAL_MODELO_LETRAS=
